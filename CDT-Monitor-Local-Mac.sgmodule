# Release v0.3.0; local files installation
#!system=mac
#!name=CDT Monitor 本地版
#!desc=直接查询阿里云 CDT/ECS/BSS；在模块参数表中填写账号与监控设置，保存后下次执行生效。
#!arguments=config_source:module,account_id:ecs-1,account_name:ECS,access_key_id,access_key_secret,region_id:cn-hongkong,instance_id,site_type:china,max_traffic_gib:200,threshold_percent:95,allow_control:false,threshold_action:notify,shutdown_mode:KeepCharging,keep_alive:false,schedule_enabled:false,start_time:08:00,stop_time:23:00,billing:false,daily_report_time:21:00,timezone_offset_minutes:480,request_timeout_seconds:10,system_notification:true,telegram_enabled:false,telegram_base_url:https://api.telegram.org,telegram_bot_token,telegram_chat_id,webhook_enabled:false,webhook_url,webhook_authorization
#!arguments-desc=config_source=module 使用本表（单账号实例），local 使用原多账号 JSON。必填 access_key_id、access_key_secret；instance_id 留空仅监控流量。max_traffic_gib 请填实际额度。开关填写 true/false，时间填写 HH:mm；threshold_action=notify/stop，site_type=china/international。默认关闭控制。参数值不使用竖线、英文双引号或换行。

[Script]
CDT-Setup = type=generic,script-path="cdt-setup.js",timeout=10,debug=true
CDT-Panel = type=generic,script-path="cdt-monitor.js",argument="cdt-module-v1|op=panel|config_source={{{config_source}}}|account_id={{{account_id}}}|account_name={{{account_name}}}|access_key_id={{{access_key_id}}}|access_key_secret={{{access_key_secret}}}|region_id={{{region_id}}}|instance_id={{{instance_id}}}|site_type={{{site_type}}}|max_traffic_gib={{{max_traffic_gib}}}|threshold_percent={{{threshold_percent}}}|allow_control={{{allow_control}}}|threshold_action={{{threshold_action}}}|shutdown_mode={{{shutdown_mode}}}|keep_alive={{{keep_alive}}}|schedule_enabled={{{schedule_enabled}}}|start_time={{{start_time}}}|stop_time={{{stop_time}}}|billing={{{billing}}}|daily_report_time={{{daily_report_time}}}|timezone_offset_minutes={{{timezone_offset_minutes}}}|request_timeout_seconds={{{request_timeout_seconds}}}|system_notification={{{system_notification}}}|telegram_enabled={{{telegram_enabled}}}|telegram_base_url={{{telegram_base_url}}}|telegram_bot_token={{{telegram_bot_token}}}|telegram_chat_id={{{telegram_chat_id}}}|webhook_enabled={{{webhook_enabled}}}|webhook_url={{{webhook_url}}}|webhook_authorization={{{webhook_authorization}}}",timeout=120
CDT-Monitor = type=cron,cronexp="*/10 * * * *",script-path="cdt-monitor.js",argument="cdt-module-v1|op=monitor|config_source={{{config_source}}}|account_id={{{account_id}}}|account_name={{{account_name}}}|access_key_id={{{access_key_id}}}|access_key_secret={{{access_key_secret}}}|region_id={{{region_id}}}|instance_id={{{instance_id}}}|site_type={{{site_type}}}|max_traffic_gib={{{max_traffic_gib}}}|threshold_percent={{{threshold_percent}}}|allow_control={{{allow_control}}}|threshold_action={{{threshold_action}}}|shutdown_mode={{{shutdown_mode}}}|keep_alive={{{keep_alive}}}|schedule_enabled={{{schedule_enabled}}}|start_time={{{start_time}}}|stop_time={{{stop_time}}}|billing={{{billing}}}|daily_report_time={{{daily_report_time}}}|timezone_offset_minutes={{{timezone_offset_minutes}}}|request_timeout_seconds={{{request_timeout_seconds}}}|system_notification={{{system_notification}}}|telegram_enabled={{{telegram_enabled}}}|telegram_base_url={{{telegram_base_url}}}|telegram_bot_token={{{telegram_bot_token}}}|telegram_chat_id={{{telegram_chat_id}}}|webhook_enabled={{{webhook_enabled}}}|webhook_url={{{webhook_url}}}|webhook_authorization={{{webhook_authorization}}}",timeout=120
CDT-Refresh = type=generic,script-path="cdt-monitor.js",argument="cdt-module-v1|op=refresh|config_source={{{config_source}}}|account_id={{{account_id}}}|account_name={{{account_name}}}|access_key_id={{{access_key_id}}}|access_key_secret={{{access_key_secret}}}|region_id={{{region_id}}}|instance_id={{{instance_id}}}|site_type={{{site_type}}}|max_traffic_gib={{{max_traffic_gib}}}|threshold_percent={{{threshold_percent}}}|allow_control={{{allow_control}}}|threshold_action={{{threshold_action}}}|shutdown_mode={{{shutdown_mode}}}|keep_alive={{{keep_alive}}}|schedule_enabled={{{schedule_enabled}}}|start_time={{{start_time}}}|stop_time={{{stop_time}}}|billing={{{billing}}}|daily_report_time={{{daily_report_time}}}|timezone_offset_minutes={{{timezone_offset_minutes}}}|request_timeout_seconds={{{request_timeout_seconds}}}|system_notification={{{system_notification}}}|telegram_enabled={{{telegram_enabled}}}|telegram_base_url={{{telegram_base_url}}}|telegram_bot_token={{{telegram_bot_token}}}|telegram_chat_id={{{telegram_chat_id}}}|webhook_enabled={{{webhook_enabled}}}|webhook_url={{{webhook_url}}}|webhook_authorization={{{webhook_authorization}}}",timeout=120
CDT-History = type=generic,script-path="cdt-monitor.js",argument="cdt-module-v1|op=history|config_source={{{config_source}}}|account_id={{{account_id}}}|account_name={{{account_name}}}|access_key_id={{{access_key_id}}}|access_key_secret={{{access_key_secret}}}|region_id={{{region_id}}}|instance_id={{{instance_id}}}|site_type={{{site_type}}}|max_traffic_gib={{{max_traffic_gib}}}|threshold_percent={{{threshold_percent}}}|allow_control={{{allow_control}}}|threshold_action={{{threshold_action}}}|shutdown_mode={{{shutdown_mode}}}|keep_alive={{{keep_alive}}}|schedule_enabled={{{schedule_enabled}}}|start_time={{{start_time}}}|stop_time={{{stop_time}}}|billing={{{billing}}}|daily_report_time={{{daily_report_time}}}|timezone_offset_minutes={{{timezone_offset_minutes}}}|request_timeout_seconds={{{request_timeout_seconds}}}|system_notification={{{system_notification}}}|telegram_enabled={{{telegram_enabled}}}|telegram_base_url={{{telegram_base_url}}}|telegram_bot_token={{{telegram_bot_token}}}|telegram_chat_id={{{telegram_chat_id}}}|webhook_enabled={{{webhook_enabled}}}|webhook_url={{{webhook_url}}}|webhook_authorization={{{webhook_authorization}}}",timeout=10
CDT-Notify-Test = type=generic,script-path="cdt-monitor.js",argument="cdt-module-v1|op=test-notify|config_source={{{config_source}}}|account_id={{{account_id}}}|account_name={{{account_name}}}|access_key_id={{{access_key_id}}}|access_key_secret={{{access_key_secret}}}|region_id={{{region_id}}}|instance_id={{{instance_id}}}|site_type={{{site_type}}}|max_traffic_gib={{{max_traffic_gib}}}|threshold_percent={{{threshold_percent}}}|allow_control={{{allow_control}}}|threshold_action={{{threshold_action}}}|shutdown_mode={{{shutdown_mode}}}|keep_alive={{{keep_alive}}}|schedule_enabled={{{schedule_enabled}}}|start_time={{{start_time}}}|stop_time={{{stop_time}}}|billing={{{billing}}}|daily_report_time={{{daily_report_time}}}|timezone_offset_minutes={{{timezone_offset_minutes}}}|request_timeout_seconds={{{request_timeout_seconds}}}|system_notification={{{system_notification}}}|telegram_enabled={{{telegram_enabled}}}|telegram_base_url={{{telegram_base_url}}}|telegram_bot_token={{{telegram_bot_token}}}|telegram_chat_id={{{telegram_chat_id}}}|webhook_enabled={{{webhook_enabled}}}|webhook_url={{{webhook_url}}}|webhook_authorization={{{webhook_authorization}}}",timeout=120
CDT-Control = type=generic,script-path="cdt-monitor.js",argument="cdt-module-v1|op=refresh|config_source={{{config_source}}}|account_id={{{account_id}}}|account_name={{{account_name}}}|access_key_id={{{access_key_id}}}|access_key_secret={{{access_key_secret}}}|region_id={{{region_id}}}|instance_id={{{instance_id}}}|site_type={{{site_type}}}|max_traffic_gib={{{max_traffic_gib}}}|threshold_percent={{{threshold_percent}}}|allow_control={{{allow_control}}}|threshold_action={{{threshold_action}}}|shutdown_mode={{{shutdown_mode}}}|keep_alive={{{keep_alive}}}|schedule_enabled={{{schedule_enabled}}}|start_time={{{start_time}}}|stop_time={{{stop_time}}}|billing={{{billing}}}|daily_report_time={{{daily_report_time}}}|timezone_offset_minutes={{{timezone_offset_minutes}}}|request_timeout_seconds={{{request_timeout_seconds}}}|system_notification={{{system_notification}}}|telegram_enabled={{{telegram_enabled}}}|telegram_base_url={{{telegram_base_url}}}|telegram_bot_token={{{telegram_bot_token}}}|telegram_chat_id={{{telegram_chat_id}}}|webhook_enabled={{{webhook_enabled}}}|webhook_url={{{webhook_url}}}|webhook_authorization={{{webhook_authorization}}}",timeout=120

[Panel]
CDT Monitor = script-name=CDT-Panel,title="CDT Monitor",content="请在模块参数中填写账号",update-interval=600

#!name=CDT Monitor
#!desc=v0.5.0 · 阿里云 CDT/ECS/BSS 本地监控；默认只读。\n首次使用：保持config_source=module，填写AccessKey ID和Secret两项并保存，然后运行CDT-Refresh。普通模式不要运行CDT-Setup。\n脚本用途：CDT-Refresh＝查询流量与状态；CDT-History＝历史日志；CDT-Notify-Test＝测试通知；CDT-Start＝手动开机；CDT-Stop＝手动关机；CDT-Monitor＝每10分钟自动监控。\nCDT-Setup＝仅高级JSON导入：先填config_json再运行，未填JSON只显示使用引导，不保存配置。
#!loon_version=3.5.1(983)

[Argument]
config_source = input,"module",type=string,tag="配置来源",desc="普通单账号保持module：填好两项密钥并保存后运行CDT-Refresh；local用于已导入的高级多账号JSON"
account_id = input,"ecs-1",type=string,tag="账号记录ID",desc="稳定且唯一的记录 ID"
account_name = input,"ECS",type=string,tag="显示名称",desc="面板显示名称"
access_key_id = input,"未设置",type=string,tag="必填·AccessKey ID",desc="必填：与AccessKey Secret配对。只填ID不能查询；保存后运行CDT-Refresh，不要运行CDT-Setup"
access_key_secret = input,"未设置",type=string,tag="必填·AccessKey Secret",desc="必填：填写该AccessKey ID对应的Secret；参数表模式无需导入JSON"
region_id = input,"cn-hongkong",type=string,tag="实例地域",desc="实例地域"
instance_id = input,"未设置",type=string,tag="实例ID（仅查流量可不填）",desc="完整 ECS 实例 ID；未设置则仅查流量"
site_type = input,"china",type=string,tag="阿里云站点",desc="china 中国站 / international 国际站"
max_traffic_gib = input,"200",type=string,tag="流量额度GiB",desc="账号分类额度，单位 GiB，请按实际额度修改"
threshold_percent = input,"95",type=string,tag="告警阈值百分比",desc="告警阈值百分比"
allow_control = input,"false",type=string,tag="实例控制总开关",desc="实例控制总开关 true / false"
threshold_action = input,"notify",type=string,tag="达到阈值后的操作",desc="notify 仅通知 / stop 停机并通知"
shutdown_mode = input,"KeepCharging",type=string,tag="停机模式",desc="KeepCharging 普通停机 / StopCharging 节省停机"
keep_alive = input,"false",type=string,tag="实例保活",desc="实例保活 true / false"
schedule_enabled = input,"false",type=string,tag="定时启停开关",desc="定时启停 true / false"
start_time = input,"08:00",type=string,tag="每天启动时间",desc="定时启动 HH:mm"
stop_time = input,"23:00",type=string,tag="每天停止时间",desc="定时停止 HH:mm"
billing = input,"false",type=string,tag="查询余额与账单",desc="余额与账单查询 true / false"
daily_report_time = input,"21:00",type=string,tag="日报时间",desc="日报 HH:mm；填写关闭可停用日报"
timezone_offset_minutes = input,"480",type=string,tag="时区偏移分钟",desc="业务时区相对 UTC 的分钟偏移"
request_timeout_seconds = input,"10",type=string,tag="请求超时秒数",desc="请求超时 3–15 秒"
system_notification = input,"true",type=string,tag="系统通知开关",desc="系统通知 true / false"
telegram_enabled = input,"false",type=string,tag="Telegram通知开关",desc="Telegram 通知 true / false"
telegram_base_url = input,"https://api.telegram.org",type=string,tag="Telegram接口地址",desc="Telegram HTTPS API 或反代地址"
telegram_bot_token = input,"未设置",type=string,tag="Telegram机器人Token",desc="Telegram Bot Token"
telegram_chat_id = input,"未设置",type=string,tag="Telegram接收者ID",desc="Telegram 接收者 Chat ID"
webhook_enabled = input,"false",type=string,tag="Webhook通知开关",desc="Webhook 通知 true / false"
webhook_url = input,"未设置",type=string,tag="Webhook地址",desc="Webhook HTTPS 地址"
webhook_authorization = input,"未设置",type=string,tag="Webhook认证",desc="Webhook Authorization 请求头；无需认证时保留未设置"
control_account = input,"ecs-1",tag=手动控制账号ID,desc=仅CDT-Start和CDT-Stop使用；必须匹配账号记录ID
control_confirm = input,"未设置",tag=手动控制完整实例ID,desc=仅手动启停使用；必须与目标实例ID完全一致
config_json = input,"",tag=高级JSON导入（普通用户留空）,desc=仅高级多账号使用：先填写完整JSON再运行CDT-Setup；普通用户填两项密钥后运行CDT-Refresh即可

[Script]
# CDT-Monitor：自动监控：每10分钟查询，执行已开启的自动策略、日报及通知重试
cron "*/10 * * * *" then script("https://raw.githubusercontent.com/MavisTok/CDT-Monitor-Plugins/v0.5.0/loon/cdt-monitor.js", {${config_source}, ${account_id}, ${account_name}, ${access_key_id}, ${access_key_secret}, ${region_id}, ${instance_id}, ${site_type}, ${max_traffic_gib}, ${threshold_percent}, ${allow_control}, ${threshold_action}, ${shutdown_mode}, ${keep_alive}, ${schedule_enabled}, ${start_time}, ${stop_time}, ${billing}, ${daily_report_time}, ${timezone_offset_minutes}, ${request_timeout_seconds}, ${system_notification}, ${telegram_enabled}, ${telegram_base_url}, ${telegram_bot_token}, ${telegram_chat_id}, ${webhook_enabled}, ${webhook_url}, ${webhook_authorization}}) with tag="CDT-Monitor", timeout=120
# CDT-Refresh：日常使用：手动查询流量、实例和可选账单，不执行自动启停
generic then script("https://raw.githubusercontent.com/MavisTok/CDT-Monitor-Plugins/v0.5.0/loon/cdt-monitor.js", {${config_source}, ${account_id}, ${account_name}, ${access_key_id}, ${access_key_secret}, ${region_id}, ${instance_id}, ${site_type}, ${max_traffic_gib}, ${threshold_percent}, ${allow_control}, ${threshold_action}, ${shutdown_mode}, ${keep_alive}, ${schedule_enabled}, ${start_time}, ${stop_time}, ${billing}, ${daily_report_time}, ${timezone_offset_minutes}, ${request_timeout_seconds}, ${system_notification}, ${telegram_enabled}, ${telegram_base_url}, ${telegram_bot_token}, ${telegram_chat_id}, ${webhook_enabled}, ${webhook_url}, ${webhook_authorization}}) with tag="CDT-Refresh", timeout=120
# CDT-History：查看历史：将小时、日快照及操作记录输出到脚本日志
generic then script("https://raw.githubusercontent.com/MavisTok/CDT-Monitor-Plugins/v0.5.0/loon/cdt-monitor.js", {${config_source}, ${account_id}, ${account_name}, ${access_key_id}, ${access_key_secret}, ${region_id}, ${instance_id}, ${site_type}, ${max_traffic_gib}, ${threshold_percent}, ${allow_control}, ${threshold_action}, ${shutdown_mode}, ${keep_alive}, ${schedule_enabled}, ${start_time}, ${stop_time}, ${billing}, ${daily_report_time}, ${timezone_offset_minutes}, ${request_timeout_seconds}, ${system_notification}, ${telegram_enabled}, ${telegram_base_url}, ${telegram_bot_token}, ${telegram_chat_id}, ${webhook_enabled}, ${webhook_url}, ${webhook_authorization}}) with tag="CDT-History", timeout=120
# CDT-Notify-Test：测试通知：向已启用的系统、Telegram和Webhook通道发送测试消息
generic then script("https://raw.githubusercontent.com/MavisTok/CDT-Monitor-Plugins/v0.5.0/loon/cdt-monitor.js", {${config_source}, ${account_id}, ${account_name}, ${access_key_id}, ${access_key_secret}, ${region_id}, ${instance_id}, ${site_type}, ${max_traffic_gib}, ${threshold_percent}, ${allow_control}, ${threshold_action}, ${shutdown_mode}, ${keep_alive}, ${schedule_enabled}, ${start_time}, ${stop_time}, ${billing}, ${daily_report_time}, ${timezone_offset_minutes}, ${request_timeout_seconds}, ${system_notification}, ${telegram_enabled}, ${telegram_base_url}, ${telegram_bot_token}, ${telegram_chat_id}, ${webhook_enabled}, ${webhook_url}, ${webhook_authorization}}) with tag="CDT-Notify-Test", timeout=120
# CDT-Start：手动开机：需开启控制总开关并填写控制账号及完整实例ID
generic then script("https://raw.githubusercontent.com/MavisTok/CDT-Monitor-Plugins/v0.5.0/loon/cdt-monitor.js", {${config_source}, ${account_id}, ${account_name}, ${access_key_id}, ${access_key_secret}, ${region_id}, ${instance_id}, ${site_type}, ${max_traffic_gib}, ${threshold_percent}, ${allow_control}, ${threshold_action}, ${shutdown_mode}, ${keep_alive}, ${schedule_enabled}, ${start_time}, ${stop_time}, ${billing}, ${daily_report_time}, ${timezone_offset_minutes}, ${request_timeout_seconds}, ${system_notification}, ${telegram_enabled}, ${telegram_base_url}, ${telegram_bot_token}, ${telegram_chat_id}, ${webhook_enabled}, ${webhook_url}, ${webhook_authorization}, ${control_account}, ${control_confirm}}) with tag="CDT-Start", timeout=120
# CDT-Stop：手动关机：需开启控制总开关并填写控制账号及完整实例ID
generic then script("https://raw.githubusercontent.com/MavisTok/CDT-Monitor-Plugins/v0.5.0/loon/cdt-monitor.js", {${config_source}, ${account_id}, ${account_name}, ${access_key_id}, ${access_key_secret}, ${region_id}, ${instance_id}, ${site_type}, ${max_traffic_gib}, ${threshold_percent}, ${allow_control}, ${threshold_action}, ${shutdown_mode}, ${keep_alive}, ${schedule_enabled}, ${start_time}, ${stop_time}, ${billing}, ${daily_report_time}, ${timezone_offset_minutes}, ${request_timeout_seconds}, ${system_notification}, ${telegram_enabled}, ${telegram_base_url}, ${telegram_bot_token}, ${telegram_chat_id}, ${webhook_enabled}, ${webhook_url}, ${webhook_authorization}, ${control_account}, ${control_confirm}}) with tag="CDT-Stop", timeout=120
# CDT-Setup：仅导入高级config_json；普通参数表用户无需运行，查看流量请运行CDT-Refresh
generic then script("https://raw.githubusercontent.com/MavisTok/CDT-Monitor-Plugins/v0.5.0/loon/cdt-setup.js", {${config_json}}) with tag="CDT-Setup", timeout=10
